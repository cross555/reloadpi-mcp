# SELF-HOST ONLY — enables get_*_offer (paid detail) + purchase_* tools.
# NEVER set this on a public deployment: the server signs from this key for
# anyone who connects. Leave it UNSET for a public browse-only host.
EVM_PRIVATE_KEY=0x...

# Optional overrides
RELOADPI_API_BASE=https://api.reloadpi.com/api/catalog   # paid x402 routes (detail + purchase)
RELOADPI_AI_BASE=https://api.reloadpi.com/ai             # free browse API
PORT=3100

# Optional: require `Authorization: Bearer <token>` on /mcp (off if unset).
# Useful to lock down a private self-hosted instance; leave unset for public browse.
# MCP_AUTH_TOKEN=
